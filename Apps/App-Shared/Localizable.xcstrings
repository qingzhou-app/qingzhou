{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "VPN 未连接，显示最近一次会话。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN is disconnected. Showing the most recent session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNは未接続です。直近のセッションを表示しています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 未連線，顯示最近一次工作階段。"
          }
        }
      }
    },
    "本次": {
      "localizations": {
