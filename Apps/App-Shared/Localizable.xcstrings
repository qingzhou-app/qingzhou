          }
        }
      }
    },
    "本轮有 %lld 次节点配置转换失败": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld node configuration conversions failed this round"
          }
