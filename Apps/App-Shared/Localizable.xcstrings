          }
        }
      }
    },
    "代理链路测试失败": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy request failed"
          }
        },
        "ja": {
          "stringUnit": {
