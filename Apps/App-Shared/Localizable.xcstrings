    "PROCESS-NAME 仅用于本机规则模拟与命中归因，xray TUN 隧道不匹配进程名。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PROCESS-NAME is used only for local rule simulation and hit attribution; the xray TUN tunnel does not match process names."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PROCESS-NAME はローカルのルールシミュレーションとヒット帰属にのみ使用され、xray TUN トンネルではプロセス名を照合しません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PROCESS-NAME 僅用於本機規則模擬與命中歸因，xray TUN 通道不匹配程序名稱。"
          }
        }
      }
    },
    "USER-AGENT 仅用于本机规则模拟，xray TUN 隧道无法匹配 HTTP User-Agent。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
