          }
        }
      },
      "extractionState": "manual"
    },
    "域名流量分析": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Domain Traffic"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメイン通信量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網域流量分析"
          }
        }
      },
      "extractionState": "manual"
    },
    "直连 · 无需节点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct · No node required"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接接続 · ノード不要"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直連 · 無需節點"
          }
        }
      },
      "extractionState": "manual"
    },
    "直连 IP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct IP"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接IP"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直連 IP"
          }
        }
      },
      "extractionState": "manual"
    },
    "当前周期暂无流量记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No traffic recorded for this period"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間の通信量記録はありません"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前週期尚無流量記錄"
          }
        }
      },
      "extractionState": "manual"
    },
    "开启 VPN 后开始记录本次流量；重新开启隧道会开始新一轮，重开主 App 不清零。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start VPN to record this session. Restarting the tunnel begins a new session; reopening the app does not reset it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNを開始するとこのセッションの記録が始まります。トンネルを再起動すると新しいセッションになり、アプリを再起動してもリセットされません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 VPN 後開始記錄本次流量；重新開啟通道會開始新一輪，重開主 App 不歸零。"
          }
        }
      },
      "extractionState": "manual"
    },
    "从此版本开始记录日度流量，无法从月度总量补回历史每日用量。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily traffic is recorded from this version onward. Historical daily usage cannot be reconstructed from monthly totals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日次通信量はこのバージョンから記録されます。月次合計から過去の日別使用量を復元することはできません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此版本開始記錄每日流量，無法從月度總量補回歷史每日用量。"
          }
        }
      },
      "extractionState": "manual"
    },
    "本次统计以 VPN 隧道会话为准。关闭再开启、模式或规则变更引发的隧道重启都会开始新一轮；仅重开主 App 不清零。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session totals follow the VPN tunnel. Restarting VPN, including restarts caused by mode or rule changes, begins a new session. Reopening the app does not reset it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション合計はVPNトンネルを基準にします。オフ・オンやモード/ルール変更による再起動で新しいセッションが始まります。アプリを再起動してもリセットされません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次統計以 VPN 通道工作階段為準。關閉再開啟、模式或規則變更引發的通道重啟都會開始新一輪；僅重開主 App 不歸零。"
          }
        }
      },
      "extractionState": "manual"
    },
    "按主域名合并，日度保留最近 31 天，月度保留最近 6 个月，仅存本机，不参与云同步。无法识别域名或超出记录上限的流量仍计入总量。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grouped by base domain. Keeps 31 days and 6 months locally, without cloud sync. Unknown and overflow domains remain included in totals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "親ドメインごとに集計し、日次は31日分、月次は6か月分を端末内にのみ保存します（iCloud同期対象外）。不明なドメインや上限超過分も合計に含まれます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依主網域合併，每日保留最近 31 天，每月保留最近 6 個月，僅存本機，不參與雲端同步。無法識別網域或超出記錄上限的流量仍計入總量。"
          }
        }
      },
      "extractionState": "manual"
    },
    "关闭主窗口仍会记录，约每 10 秒保存一次。日期和月份按保存时的本地时间划分，跨日/月附近可能有少量偏差；隧道停止时最后数秒可能尚未保存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording continues with the main window closed and saves about every 10 seconds. Days and months use local time at sampling; boundary samples may be slightly offset. The final seconds before stopping may not be saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインウィンドウを閉じても記録を続け、約10秒ごとに保存します。日付と月は保存時の現地時間で区分されるため境界付近でわずかにずれる場合があり、停止直前の数秒間は保存されないことがあります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉主視窗仍會記錄，約每 10 秒儲存一次。日期和月份依儲存時的本機時間劃分，跨日/月附近可能有少量偏差；通道停止時最後數秒可能尚未儲存。"
          }
        }
      },
      "extractionState": "manual"
    },
    "查询失败，请重试": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lookup failed. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照会に失敗しました。再試行してください"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查詢失敗，請重試"
          }
        }
      }
    },
    "节点出口查询超时": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node exit lookup timed out"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノード出口の照会がタイムアウトしました"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節點出口查詢逾時"
          }
        }
      }
    },
    "节点出口查询失败": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node exit lookup failed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノード出口の照会に失敗しました"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節點出口查詢失敗"
          }
        }
      }
    },
    "云端有更新，自动上传已暂停；请手动恢复或处理版本差异": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud changes found. Automatic uploads are paused; restore manually or resolve the differences."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドに変更があります。自動アップロードは一時停止中です。手動で復元するか差分を解決してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端有更新，自動上傳已暫停；請手動恢復或處理版本差異"
          }
        }
      }
    },
    "不会自动弹出恢复提示。需要恢复时，请点上方按钮选择云端版本；出现版本差异时会暂停自动上传，保留两边配置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore prompts never appear automatically. Use the button above to choose a cloud version. When versions differ, automatic uploads pause to preserve both copies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元プロンプトは自動表示されません。復元するには上のボタンからクラウド版を選択してください。差分がある場合は両方を保護するため自動アップロードを一時停止します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會自動彈出恢復提示。需要恢復時，請點上方按鈕選擇雲端版本；出現版本差異時會暫停自動上傳，保留兩邊設定。"
          }
        }
      }
    },
    "记录暂未更新，当前数字可能不包含最近的流量。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording has not updated recently. These totals may exclude recent traffic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が最近更新されていません。現在の数値には直近の通信量が含まれていない可能性があります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄暫未更新，目前數字可能不包含最近的流量。"
          }
        }
      }
    },
