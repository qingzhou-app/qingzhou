    "下载": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載"
          }
        }
      }
    },
    "仅统计这台设备经过轻舟的流量；搜索不改变上方总量。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only traffic through Qingzhou on this device is counted. Search does not change the totals above."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでQingzhouを経由した通信量のみを集計します。検索しても上の合計は変わりません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅統計這台裝置經過輕舟的流量；搜尋不改變上方總量。"
          }
        }
      }
    },
    "统计文件暂时无法读取，已保留原文件；下方可能是上次读取的数据。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The traffic history cannot be read right now. The original file is preserved; the data below may be from the last successful read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信量履歴を読み込めませんでした。元のファイルは保持されており、以下は前回読み込み時のデータの可能性があります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "統計檔案暫時無法讀取，已保留原檔案；下方可能是上次讀取的資料。"
          }
        }
      }
    },
    "这个月还没有流量记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No traffic history for this month"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この月の通信量記録はまだありません"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個月還沒有流量記錄"
          }
        }
      }
    },
    "安装此版本并重新开启 VPN 后开始记录，无法补回此前的域名流量。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording starts after installing this version and restarting the VPN. Earlier domain traffic cannot be recovered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンをインストールしてVPNを再起動すると記録が始まります。それ以前のドメイン通信量は復元できません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝此版本並重新開啟 VPN 後開始記錄，無法補回此前的網域流量。"
          }
        }
      }
    },
    "当前范围尚未记录到流量。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No traffic recorded in this scope yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この範囲ではまだ通信量が記録されていません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前範圍尚未記錄到流量。"
          }
        }
      }
    },
    "没有匹配的域名。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching domains."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するドメインがありません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有符合的網域。"
          }
        }
      }
    },
    "域名流量排行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic by domain"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメイン別通信量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網域流量排行"
          }
        }
      }
    },
    "记录范围与计费差异": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coverage and billing differences"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録範囲と課金の差異"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄範圍與計費差異"
          }
        }
      }
    },
    "开始记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First recorded"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録開始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始記錄"
          }
        }
      }
    },
    "最近更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last updated"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近更新"
          }
        }
      }
    },
    "归档时区": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording time zone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録タイムゾーン"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歸檔時區"
          }
        }
      }
    },
    "按主域名合并，保留最近 6 个月，仅存本机，不参与云同步。无法识别域名或超出记录上限的流量仍计入总量。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic is grouped by parent domain and kept locally for 6 months, without cloud sync. Unidentified domains and traffic beyond the record limit still count toward the totals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信量は親ドメインごとに集計し、端末内に6か月間保存します（iCloud同期対象外）。不明なドメインや上限超過分も合計に含まれます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依主網域合併，保留最近 6 個月，僅存本機，不參與雲端同步。無法識別網域或超出記錄上限的流量仍計入總量。"
          }
        }
      }
    },
    "关闭主窗口仍会记录，约每 10 秒保存一次。月份按保存时的本地时间划分，跨月附近可能有少量偏差；隧道停止时最后数秒可能尚未保存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording continues with the main window closed and saves about every 10 seconds. Months follow local time at each save, so traffic near a month boundary may be slightly shifted. The final few seconds may be lost when the tunnel stops."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインウィンドウを閉じても記録を続け、約10秒ごとに保存します。月は保存時の現地時間で区分されるため月末付近でわずかにずれる場合があり、停止直前の数秒間は保存されないことがあります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉主視窗仍會記錄，約每 10 秒儲存一次。月份依儲存時的本機時間劃分，跨月附近可能有少量偏差；通道停止時最後數秒可能尚未儲存。"
          }
        }
      }
    },
    "这里统计应用载荷，不等于订阅账单。节点倍率、加密封装、重传和其他设备的用量，可能让账单更高；没有经过轻舟的流量不在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These application payload totals are not your subscription bill. Node multipliers, encryption overhead, retransmissions and other devices may increase billed usage. Traffic outside Qingzhou is not included."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここはアプリケーションのペイロード集計であり、サブスクリプションの請求量とは異なります。ノード倍率、暗号化オーバーヘッド、再送、他デバイスの利用分により請求量は多くなる場合があり、Qingzhouを通らない通信は含まれません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡統計應用載荷，不等於訂閱帳單。節點倍率、加密封裝、重傳和其他裝置的用量，可能讓帳單更高；沒有經過輕舟的流量不在這裡。"
          }
        }
      }
    },
    "连接诊断": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection diagnostics"
