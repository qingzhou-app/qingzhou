    "自动：hysteria2 节点放行并实测，其余挡 QUIC 走 TCP": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic: allow and test QUIC on hysteria2 nodes; block it on others to fall back to TCP"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動：hysteria2 ノードでは QUIC を許可して実測し、その他はブロックして TCP にフォールバックさせます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動：hysteria2 節點放行並實測，其餘阻擋 QUIC 改走 TCP"
          }
        }
      }
    },
