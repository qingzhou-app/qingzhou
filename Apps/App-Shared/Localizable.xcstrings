          }
        }
      }
    },
    "当前节点双目标复核失败，已选择本轮测通的节点": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current node failed both checks; selected a node verified this round"
