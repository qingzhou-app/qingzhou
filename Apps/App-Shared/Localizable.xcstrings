          "stringUnit": {
            "state": "translated",
            "value": "代理鏈路測試失敗"
          }
        }
      }
    },
    "代理测试暂不可用，请稍后重试": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy testing is unavailable; try again later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシテストは現在利用できません。しばらくしてから再試行してください"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理測試暫不可用，請稍後重試"
          }
        }
      }
    },
    "未测试，请先连接 VPN": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not tested; connect the VPN first"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未テストです。先にVPNに接続してください"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未測試，請先連線 VPN"
          }
        }
      }
    },
    "本次节点代理请求成功。结果仅代表当前网络和测试目标。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy request succeeded. This result applies only to this network and test target."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシリクエストに成功しました。この結果は現在のネットワークとテスト対象にのみ当てはまります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次節點代理請求成功。結果僅代表目前網路和測試目標。"
          }
        }
      }
    },
    "请检查节点凭据、传输配置及测试目标；TCP 连通不能证明代理可用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check node credentials, transport settings, and the test target. TCP connectivity does not prove proxy usability."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードの認証情報、トランスポート設定、テスト対象を確認してください。TCP接続の成功はプロキシの疎通を保証しません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查節點憑證、傳輸設定及測試目標；TCP 連通不能證明代理可用。"
          }
        }
      }
    },
    "当前只有直连结果，连接 VPN 后可继续验证真实代理链路。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only direct connectivity was tested. Connect the VPN to verify a real proxy request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接接続のみテスト済みです。VPNに接続すると実際のプロキシ経路を確認できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有直連結果，連線 VPN 後可繼續驗證真實代理鏈路。"
          }
        }
      }
    },
    "本次未获得有效代理结果，不能据此判断节点故障。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No valid proxy result was obtained. This does not establish a node failure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なプロキシ結果を得られませんでした。これだけではノード障害とは断定できません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次未獲得有效代理結果，不能據此判斷節點故障。"
          }
        }
      }
    },
    "开启后按地区偏好与综合评分自动择优。正常切换需连续两轮领先；若希望保留手选节点，请关闭自动择优。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically select by region preference and overall score. Normal switches require a lead in two consecutive rounds. Turn this off to keep your manual selection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると優先地域と総合スコアで自動選択します。通常の切り替えには2回連続で上回る必要があります。手動選択を保つ場合はオフにしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後依地區偏好與綜合評分自動擇優。正常切換需連續兩輪領先；若希望保留手選節點，請關閉自動擇優。"
          }
        }
      }
    },
    "VPN 运行中，每轮最多对 6 个候选做真实代理测量，并可额外复核 2 次；包含当前节点、可用 TCP 候选及 UDP 节点。未确认可用时保留当前选择。自动测速仍只测直连，关闭本开关会清空经代理延迟。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the VPN is running, each round tests up to 6 candidates through their proxies, with up to 2 additional checks. Candidates include the current node, eligible TCP nodes, and UDP nodes. If availability is not confirmed, the current selection is kept. Automatic latency testing still measures direct connections only. Turning this off clears proxy latency measurements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN接続中、各ラウンドで最大6つの候補をプロキシ経由で実測し、最大2回の追加確認を行います（現在のノード、利用可能なTCP候補、UDPノードを含む）。疎通が確認できない場合は現在の選択を維持します。自動速度測定は直接接続のみを計測し、このスイッチをオフにするとプロキシ遅延記録は消去されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 執行中，每輪最多對 6 個候選做真實代理測量，並可額外複核 2 次；包含目前節點、可用 TCP 候選及 UDP 節點。未確認可用時保留目前選擇。自動測速仍只測直連，關閉本開關會清空經代理延遲。"
          }
        }
      }
    },
    "按延迟、稳定性、近期下载观测与成本综合评分。速度优先更看重延迟；均衡兼顾四项；省流量更看重低倍率。改选下轮择优生效。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores combine latency, stability, recent download observations, and cost. Speed favors latency, Balanced considers all four, and Saver favors lower traffic multipliers. Changes apply in the next selection round."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅延、安定性、最近のダウンロード観測、コストから総合評価します。速度優先は遅延を重視、バランスは4項目を均等考慮、節約は低倍率を重視します。変更は次の選択ラウンドから反映されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依延遲、穩定性、近期下載觀測與成本綜合評分。速度優先更看重延遲；均衡兼顧四項；省流量更看重低倍率。改選下輪擇優生效。"
          }
        }
      }
    },
    "无（按综合评分）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None (use overall score)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし（総合スコア順）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無（依綜合評分）"
          }
        }
      }
    },
    "优先地区有符合条件的候选时，在该地区内按综合评分选择；否则在所有符合条件的候选中选择。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the preferred region has eligible candidates, select within that region by overall score. Otherwise, select from all eligible candidates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先地域に条件を満たす候補がある場合はその地域内で総合スコアにより選択し、ない場合は全候補から選択します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先地區有符合條件的候選時，在該地區內依綜合評分選擇；否則在所有符合條件的候選中選擇。"
          }
        }
      }
    },
    "%lld 个节点；开启后排除此地区": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nodes; turn on to exclude this region"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のノード；オンにするとこの地域を除外します"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個節點；開啟後排除此地區"
          }
        }
      }
    },
    "自动测速每轮最多 24 组配置；复用近期结果 %lld 组，余下 %lld 组留待后续轮换": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic testing checks up to 24 configurations per round; reused %1$lld recent results, with %2$lld configurations left for later rounds"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動測定は1ラウンド最大24件の設定を確認します。直近の結果 %1$lld 件を再利用し、残り %2$lld 件を次回以降へ回します"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動測速每輪最多 24 組設定；複用近期結果 %1$lld 組，餘下 %2$lld 組留待後續輪替"
          }
        }
      }
    },
    "网络路径已变化，本轮旧测量已作废": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network path changed; previous measurements from this round were discarded"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク経路が変更されたため、このラウンドの古い測定結果は破棄されました"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路路徑已變化，本輪舊測量已作廢"
          }
        }
      }
    },
    "近期下载观测": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent download observation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のダウンロード観測"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "近期下載觀測"
          }
        }
      }
    },
    "本轮精选 %lld 个候选，含轮换探索 %lld 个；最多 6 个候选及 2 次复核": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortlisted %1$lld candidates, including %2$lld rotating candidates; up to 6 candidates and 2 confirmation probes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このラウンドで %1$lld 件の候補を選出（ローテーション探索 %2$lld 件含む）；最大6候補・2回確認"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本輪精選 %1$lld 個候選，含輪替探索 %2$lld 個；最多 6 個候選及 2 次複核"
          }
        }
      }
    },
    "近 30 分钟可归属到此节点的代理下载观测，至少覆盖 3 个分钟，过滤孤立尖峰。未额外下载，不能视为线路最大带宽。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy downloads attributable to this node in the last 30 minutes, covering at least 3 minutes and filtering isolated spikes. No extra downloads; this is not the maximum link capacity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去30分間でこのノードに帰属できるプロキシ経由のダウンロード観測（3分以上のデータを使用し一時的なスパイクを除外）。追加通信は行っておらず、回線の最大帯域ではありません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "近 30 分鐘可歸屬到此節點的代理下載觀測，至少覆蓋 3 個分鐘，過濾孤立尖峰。未額外下載，不能視為線路最大頻寬。"
          }
        }
      }
    },
    "全链路可用性未确认，保持原选择": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end availability is unconfirmed; keeping the existing selection"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドツーエンドの疎通が確認できないため、現在の選択を維持しました"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
