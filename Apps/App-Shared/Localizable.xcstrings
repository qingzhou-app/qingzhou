    "诊断已失效，请重新运行。未保存的节点修改请先保存。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics are no longer current. Save any node changes, then run again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断結果は古くなっています。ノードの変更を保存してから再実行してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷已失效，請重新執行。未儲存的節點修改請先儲存。"
          }
        }
      }
    },
    "分别检查直连与真实代理，不切换当前节点。报告不含节点名称、地址、凭据或订阅链接。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tests direct connectivity and proxy requests separately without switching the current node. Reports omit node names, addresses, credentials, and subscription links."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のノードを切り替えずに直接接続とプロキシ経由の通信を個別に確認します。レポートにノード名、アドレス、認証情報、サブスクリプションURLは含まれません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分別檢查直連與真實代理，不切換目前節點。報告不含節點名稱、位址、憑證或訂閱連結。"
          }
        }
      }
    },
    "UDP 协议不适用 TCP 握手": {
      "extractionState": "manual",
